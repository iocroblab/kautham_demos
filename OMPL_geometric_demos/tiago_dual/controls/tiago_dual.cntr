<?xml version="1.0" encoding="UTF-8"?>

<ControlSet>

	<Offset>
		
		<!-- WHEELS -->
		<DOF robot="tiago_dual" name="wheel_right_joint" value="0.5"/>
		<DOF robot="tiago_dual" name="wheel_left_joint" value="0.5"/>

		<!-- TORSO -->
		<DOF robot="tiago_dual" name="torso_lift_joint" value="0.5"/>
		
		<!-- ARM LEFT -->
		<DOF robot="tiago_dual" name="arm_left_1_joint" value="0.5"/>
		<DOF robot="tiago_dual" name="arm_left_2_joint" value="0.5"/>
		<DOF robot="tiago_dual" name="arm_left_3_joint" value="0.5"/>
		<DOF robot="tiago_dual" name="arm_left_4_joint" value="0.5"/>
		<DOF robot="tiago_dual" name="arm_left_5_joint" value="0.5"/>
		<DOF robot="tiago_dual" name="arm_left_6_joint" value="0.5"/>
		<DOF robot="tiago_dual" name="arm_left_7_joint" value="0.5"/>

		<!-- GRIPPER LEFT -->
		<DOF robot="tiago_dual" name="gripper_left_left_finger_joint" value="0.5"/>
		<DOF robot="tiago_dual" name="gripper_left_right_finger_joint" value="0.5"/>

		<!-- ARM RIGHT -->
		<DOF robot="tiago_dual" name="arm_right_1_joint" value="0.5"/>
		<DOF robot="tiago_dual" name="arm_right_2_joint" value="0.5"/>
		<DOF robot="tiago_dual" name="arm_right_3_joint" value="0.5"/>
		<DOF robot="tiago_dual" name="arm_right_4_joint" value="0.5"/>
		<DOF robot="tiago_dual" name="arm_right_5_joint" value="0.5"/>
		<DOF robot="tiago_dual" name="arm_right_6_joint" value="0.5"/>
		<DOF robot="tiago_dual" name="arm_right_7_joint" value="0.5"/>

		<!-- GRIPPER RIGHT -->
		<DOF robot="tiago_dual" name="gripper_right_left_finger_joint" value="0.5"/>
		<DOF robot="tiago_dual" name="gripper_right_right_finger_joint" value="0.5"/>

		<!-- HEAD -->
		<DOF robot="tiago_dual" name="head_1_joint" value="0.5"/>
		<DOF robot="tiago_dual" name="head_2_joint" value="0.5"/>
		
	</Offset>


	<!-- WHEELS -->
	<Control name="wheel_right_joint" eigValue="1.0">
		<DOF robot="tiago_dual" name="wheel_right_joint" value="1.0"/>
	</Control>
	<Control name="wheel_left_joint" eigValue="1.0">
		<DOF robot="tiago_dual" name="wheel_left_joint" value="1.0"/>
	</Control>

	<!-- TORSO -->
	<Control name="torso_lift_joint" eigValue="1.0">
		<DOF robot="tiago_dual" name="torso_lift_joint" value="1.0"/>
	</Control>

	<!-- ARM LEFT -->
	<Control name="arm_left_1_joint" eigValue="1.0">
		<DOF robot="tiago_dual" name="arm_left_1_joint" value="1.0"/>
	</Control>
	<Control name="arm_left_2_joint" eigValue="1.0">
		<DOF robot="tiago_dual" name="arm_left_2_joint" value="1.0"/>
	</Control>
	<Control name="arm_left_3_joint" eigValue="1.0">
		<DOF robot="tiago_dual" name="arm_left_3_joint" value="1.0"/>
	</Control>
	<Control name="arm_left_4_joint" eigValue="1.0">
		<DOF robot="tiago_dual" name="arm_left_4_joint" value="1.0"/>
	</Control>
	<Control name="arm_left_5_joint" eigValue="1.0">
		<DOF robot="tiago_dual" name="arm_left_5_joint" value="1.0"/>
	</Control>
	<Control name="arm_left_6_joint" eigValue="1.0">
		<DOF robot="tiago_dual" name="arm_left_6_joint" value="1.0"/>
	</Control>
	<Control name="arm_left_7_joint" eigValue="1.0">
		<DOF robot="tiago_dual" name="arm_left_7_joint" value="1.0"/>
	</Control>

	<!-- GRIPPER LEFT -->
	<Control name="gripper_left_finger_joint" eigValue="1.0">
		<DOF robot="tiago_dual" name="gripper_left_left_finger_joint" value="1.0"/>
		<DOF robot="tiago_dual" name="gripper_left_right_finger_joint" value="1.0"/>
	</Control>

	<!-- ARM RIGHT -->
	<Control name="arm_right_1_joint" eigValue="1.0">
		<DOF robot="tiago_dual" name="arm_right_1_joint" value="1.0"/>
	</Control>
	<Control name="arm_right_2_joint" eigValue="1.0">
		<DOF robot="tiago_dual" name="arm_right_2_joint" value="1.0"/>
	</Control>
	<Control name="arm_right_3_joint" eigValue="1.0">
		<DOF robot="tiago_dual" name="arm_right_3_joint" value="1.0"/>
	</Control>
	<Control name="arm_right_4_joint" eigValue="1.0">
		<DOF robot="tiago_dual" name="arm_right_4_joint" value="1.0"/>
	</Control>
	<Control name="arm_right_5_joint" eigValue="1.0">
		<DOF robot="tiago_dual" name="arm_right_5_joint" value="1.0"/>
	</Control>
	<Control name="arm_right_6_joint" eigValue="1.0">
		<DOF robot="tiago_dual" name="arm_right_6_joint" value="1.0"/>
	</Control>
	<Control name="arm_right_7_joint" eigValue="1.0">
		<DOF robot="tiago_dual" name="arm_right_7_joint" value="1.0"/>
	</Control>

	<!-- GRIPPER RIGHT -->
	<Control name="gripper_right_finger_joint" eigValue="1.0">
		<DOF robot="tiago_dual" name="gripper_right_left_finger_joint" value="1.0"/>
		<DOF robot="tiago_dual" name="gripper_right_right_finger_joint" value="1.0"/>
	</Control>

	<!-- HEAD -->
	<Control name="head_1_joint" eigValue="1.0">
		<DOF robot="tiago_dual" name="head_1_joint" value="1.0"/>
	</Control>
	<Control name="head_2_joint" eigValue="1.0">
		<DOF robot="tiago_dual" name="head_2_joint" value="1.0"/>
	</Control>


</ControlSet>
