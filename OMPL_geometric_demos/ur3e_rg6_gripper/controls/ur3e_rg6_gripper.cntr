<?xml version="1.0" encoding="UTF-8"?>

<ControlSet>

	<!-- DOF OFFSETs -->

    <Offset>		

	</Offset>

	<!-- CONTROLS -->

    <Control name="shoulder_pan_joint" eigValue="1.0">
		<DOF robot="ur3e_rg6_gripper" name="shoulder_pan_joint" value="1.0"/>
	</Control>
	<Control name="shoulder_lift_joint" eigValue="1.0">
		<DOF robot="ur3e_rg6_gripper" name="shoulder_lift_joint" value="1.0"/>
	</Control> 
	<Control name="elbow_joint" eigValue="1.0">
		<DOF robot="ur3e_rg6_gripper" name="elbow_joint" value="1.0"/>
	</Control> 
	<Control name="wrist_1_joint" eigValue="1.0">
		<DOF robot="ur3e_rg6_gripper" name="wrist_1_joint" value="1.0"/>
	</Control>
	<Control name="wrist_2_joint" eigValue="1.0">
		<DOF robot="ur3e_rg6_gripper" name="wrist_2_joint" value="1.0"/>
	</Control>
	<Control name="wrist_3_joint" eigValue="1.0">
		<DOF robot="ur3e_rg6_gripper" name="wrist_3_joint" value="1.0"/>
	</Control>
	<Control name="gripper_joint" eigValue="1.0">
		<DOF robot="ur3e_rg6_gripper" name="l_out" value="-1.0"/>
		<DOF robot="ur3e_rg6_gripper" name="r_out" value="1.0"/>
		<DOF robot="ur3e_rg6_gripper" name="l_tip" value="-1.0"/>
		<DOF robot="ur3e_rg6_gripper" name="r_tip" value="1.0"/>
		<DOF robot="ur3e_rg6_gripper" name="l_passive" value="1.0"/>
		<DOF robot="ur3e_rg6_gripper" name="r_passive" value="1.0"/>
	</Control>

</ControlSet>
