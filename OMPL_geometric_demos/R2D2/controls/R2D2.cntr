<?xml version="1.0" encoding="UTF-8"?>

<ControlSet>

	<Offset>

		<DOF robot="R2D2" name="right_front_wheel_joint" value="0.5"/>
		<DOF robot="R2D2" name="right_back_wheel_joint" value="0.5"/>
		<DOF robot="R2D2" name="left_front_wheel_joint" value="0.5"/>
		<DOF robot="R2D2" name="left_back_wheel_joint" value="0.5"/>
		<DOF robot="R2D2" name="gripper_extension" value="0.5"/>
		<DOF robot="R2D2" name="left_gripper_joint" value="0.5"/>
		<DOF robot="R2D2" name="right_gripper_joint" value="0.5"/>
		<DOF robot="R2D2" name="head_swivel" value="0.5"/>
		
	</Offset>



	<Control name="right_front_wheel_joint" eigValue="1.0">
		<DOF robot="R2D2" name="right_front_wheel_joint" value="1.0"/>
	</Control>
	<Control name="right_back_wheel_joint" eigValue="1.0">
		<DOF robot="R2D2" name="right_back_wheel_joint" value="1.0"/>
	</Control>
	<Control name="left_front_wheel_joint" eigValue="1.0">
		<DOF robot="R2D2" name="left_front_wheel_joint" value="1.0"/>
	</Control>
	<Control name="left_back_wheel_joint" eigValue="1.0">
		<DOF robot="R2D2" name="left_back_wheel_joint" value="1.0"/>
	</Control>
	<Control name="gripper_extension" eigValue="1.0">
		<DOF robot="R2D2" name="gripper_extension" value="1.0"/>
	</Control>
	<Control name="gripper_joint" eigValue="1.0">
		<DOF robot="R2D2" name="left_gripper_joint" value="1.0"/>
		<DOF robot="R2D2" name="right_gripper_joint" value="1.0"/>
	</Control>
	<Control name="head_swivel" eigValue="1.0">
	<DOF robot="R2D2" name="head_swivel" value="1.0"/>
	</Control>


</ControlSet>
