<?xml version="1.0"?>

<Problem name="madar_dual_arm">

    <Robot robot="./robots/robot_instances/MADAR/madar_dual_arm.urdf.xacro">
        <KauthamName name="madar" />
		<Home TH="1.0" WZ="0.0" WY="0.0" WX="0.0" Z="0.0" Y="0.0" X="0.0" />
		<Limits name="X" min="-5.0" max="5.0" />
		<Limits name="Y" min="-5.0" max="5.0" />

    </Robot>

    <Controls robot="./controls/madar_dual_arm.cntr" />

    <Planner>
		<Parameters>
            <Name>omplRRTConnect</Name>
			<Parameter name="_Max Planning Time">10.0</Parameter>
			<Parameter name="_Speed Factor">1</Parameter>
			<Parameter name="Range">10</Parameter>
			<Parameter name="_Simplify Solution">0</Parameter>
			<Parameter name="_Incremental (0/1)">0</Parameter>
		</Parameters>
		<Queries>
			<Query>
				<!-- SE3 Controls -->
				<RobotControl name="madar_platform_x" 	init="0.5" goal="0.48"/>
				<RobotControl name="madar_platform_y" 	init="0.3" goal="0.5"/>
				<RobotControl name="madar_platform_Rz"  init="0.5" goal="0.5"/>

				<!-- Arm Right Controls -->
				<RobotControl name="madar_arm_right_shoulder_pan_joint" 	init="0.630" goal="0.585"/>
				<RobotControl name="madar_arm_right_shoulder_lift_joint"	init="0.380" goal="0.430"/>
				<RobotControl name="madar_arm_right_elbow_joint" 			init="0.580" goal="0.590"/>
				<RobotControl name="madar_arm_right_wrist_1_joint" 			init="0.540" goal="0.485"/>
				<RobotControl name="madar_arm_right_wrist_2_joint" 			init="0.630" goal="0.580"/>
				<RobotControl name="madar_arm_right_wrist_3_joint" 			init="0.560" goal="0.560"/>

				<!-- Arm Left Controls -->
				<RobotControl name="madar_arm_left_shoulder_pan_joint" 		init="0.400" goal="0.400"/>
				<RobotControl name="madar_arm_left_shoulder_lift_joint" 	init="0.300" goal="0.300"/>
				<RobotControl name="madar_arm_left_elbow_joint"				init="0.300" goal="0.450"/>
				<RobotControl name="madar_arm_left_wrist_1_joint" 			init="0.500" goal="0.350"/>
				<RobotControl name="madar_arm_left_wrist_2_joint" 			init="0.500" goal="0.300"/>
				<RobotControl name="madar_arm_left_wrist_3_joint" 			init="0.500" goal="0.500"/>
			</Query>
		</Queries>
	</Planner>

</Problem>