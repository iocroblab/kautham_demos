<?xml version="1.0"?>

<ControlSet>

	<!-- ################################### -->
	<!-- #### OFFSET DEGREES OF FREEDOM #### -->
	<!-- ################################### -->

	<Offset>

		<!-- BEGIN: PLATFORM -->

		<DOF robot="madar" name="X" value="0.5" />
		<DOF robot="madar" name="Y" value="0.5" />
		<DOF robot="madar" name="Z" value="0.0" />
        <DOF robot="madar" name="X1" value="0.0"/>
        <DOF robot="madar" name="X2" value="0.0"/>
        <DOF robot="madar" name="X3" value="0.75"/>
		
		<!-- END: PLATFORM -->
		

		<!-- BEGIN: ARM RIGHT -->

        <DOF robot="madar" name="arm_right_shoulder_pan_joint" value="0.630"/>
        <DOF robot="madar" name="arm_right_shoulder_lift_joint" value="0.380"/>
        <DOF robot="madar" name="arm_right_elbow_joint" value="0.580"/>
        <DOF robot="madar" name="arm_right_wrist_1_joint" value="0.540"/>
        <DOF robot="madar" name="arm_right_wrist_2_joint" value="0.630"/>
        <DOF robot="madar" name="arm_right_wrist_3_joint" value="0.700"/>

		<!-- END: ARM RIGHT -->


		<!-- BEGIN: ARM LEFT -->

        <DOF robot="madar" name="arm_left_shoulder_pan_joint" value="0.5"/>
        <DOF robot="madar" name="arm_left_shoulder_lift_joint" value="0.5"/>
        <DOF robot="madar" name="arm_left_elbow_joint" value="0.5"/>
        <DOF robot="madar" name="arm_left_wrist_1_joint" value="0.5"/>
        <DOF robot="madar" name="arm_left_wrist_2_joint" value="0.5"/>
        <DOF robot="madar" name="arm_left_wrist_3_joint" value="0.5"/>

		<!-- END: ARM LEFT -->


		<!-- BEGIN: HAND RIGHT -->

		<!-- Index Finger -->
		<DOF robot="madar" name="hand_right_joint_0_0" value="0.5" />
		<DOF robot="madar" name="hand_right_joint_1_0" value="0.25" />
		<DOF robot="madar" name="hand_right_joint_2_0" value="0.25" />
		<DOF robot="madar" name="hand_right_joint_3_0" value="0.5" />
		
		<!-- Middle Finger -->
		<DOF robot="madar" name="hand_right_joint_4_0" value="0.5" />
		<DOF robot="madar" name="hand_right_joint_5_0" value="0.25" />
		<DOF robot="madar" name="hand_right_joint_6_0" value="0.25" />
		<DOF robot="madar" name="hand_right_joint_7_0" value="0.5" />
		
		<!-- Ring Finger -->
		<DOF robot="madar" name="hand_right_joint_8_0" value="0.5" />
		<DOF robot="madar" name="hand_right_joint_9_0" value="0.25" />
		<DOF robot="madar" name="hand_right_joint_10_0" value="0.25" />
		<DOF robot="madar" name="hand_right_joint_11_0" value="0.5" />
		
		<!-- Thumb Finger -->
		<DOF robot="madar" name="hand_right_joint_12_0" value="0.1" />
		<DOF robot="madar" name="hand_right_joint_13_0" value="0.3" />
		<DOF robot="madar" name="hand_right_joint_14_0" value="0.2" />
		<DOF robot="madar" name="hand_right_joint_15_0" value="0.5" />

		<!-- END: HAND RIGHT -->


		<!-- BEGIN: HAND LEFT -->

		<!-- Left Index Finger -->
		<DOF robot="madar" name="hand_left_joint_0_0" value="0.5" />
		<DOF robot="madar" name="hand_left_joint_1_0" value="0.25" />
		<DOF robot="madar" name="hand_left_joint_2_0" value="0.25" />
		<DOF robot="madar" name="hand_left_joint_3_0" value="0.5" />
		
		<!-- Left Middle Finger -->
		<DOF robot="madar" name="hand_left_joint_4_0" value="0.5" />
		<DOF robot="madar" name="hand_left_joint_5_0" value="0.25" />
		<DOF robot="madar" name="hand_left_joint_6_0" value="0.25" />
		<DOF robot="madar" name="hand_left_joint_7_0" value="0.5" />
		
		<!-- Left Ring Finger -->
		<DOF robot="madar" name="hand_left_joint_8_0" value="0.5" />
		<DOF robot="madar" name="hand_left_joint_9_0" value="0.25" />
		<DOF robot="madar" name="hand_left_joint_10_0" value="0.25" />
		<DOF robot="madar" name="hand_left_joint_11_0" value="0.5" />
		
		<!-- Left Thumb Finger -->
		<DOF robot="madar" name="hand_left_joint_12_0" value="0.1" />
		<DOF robot="madar" name="hand_left_joint_13_0" value="0.3" />
		<DOF robot="madar" name="hand_left_joint_14_0" value="0.2" />
		<DOF robot="madar" name="hand_left_joint_15_0" value="0.5" />

		<!-- END: HAND LEFT -->		


	</Offset>


	<!-- ################################ -->
	<!-- #### CONTROLLERS : PLATFORM #### -->
	<!-- ################################ -->

	<!-- BEGIN: ARM LEFT -->
	<Control name="madar_arm_left_shoulder_pan_joint" eigValue="1.0">
		<DOF robot="madar" name="arm_left_shoulder_pan_joint" value="1.0" />
	</Control>

	<Control name="madar_arm_left_shoulder_lift_joint" eigValue="1.0">
		<DOF robot="madar" name="arm_left_shoulder_lift_joint" value="1.0" />
	</Control>

	<Control name="madar_arm_left_elbow_joint" eigValue="1.0">
		<DOF robot="madar" name="arm_left_elbow_joint" value="1.0" />
	</Control>

	<Control name="madar_arm_left_wrist_1_joint" eigValue="1.0">
		<DOF robot="madar" name="arm_left_wrist_1_joint" value="1.0" />
	</Control>

	<Control name="madar_arm_left_wrist_2_joint" eigValue="1.0">
		<DOF robot="madar" name="arm_left_wrist_2_joint" value="1.0" />
	</Control>

	<Control name="madar_arm_left_wrist_3_joint" eigValue="1.0">
		<DOF robot="madar" name="arm_left_wrist_3_joint" value="1.0" />
	</Control>
	<!-- END: ARM LEFT -->


</ControlSet>