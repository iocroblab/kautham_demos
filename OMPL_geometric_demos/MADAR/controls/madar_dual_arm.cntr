<?xml version="1.0"?>

<ControlSet>

	<!-- ################################### -->
	<!-- #### OFFSET DEGREES OF FREEDOM #### -->
	<!-- ################################### -->

	<Offset>

		<!-- BEGIN: PLATFORM -->

		<DOF robot="madar" name="X" value="0.5" />
		<DOF robot="madar" name="Y" value="0.5" />
		<DOF robot="madar" name="Z" value="0.0" />
        <DOF robot="madar" name="X1" value="0.0"/>
        <DOF robot="madar" name="X2" value="0.0"/>
        <DOF robot="madar" name="X3" value="0.75"/>
		
		<!-- END: PLATFORM -->
		

		<!-- BEGIN: ARM RIGHT -->

        <DOF robot="madar" name="arm_right_shoulder_pan_joint" value="0.5"/>
        <DOF robot="madar" name="arm_right_shoulder_lift_joint" value="0.5"/>
        <DOF robot="madar" name="arm_right_elbow_joint" value="0.5"/>
        <DOF robot="madar" name="arm_right_wrist_1_joint" value="0.5"/>
        <DOF robot="madar" name="arm_right_wrist_2_joint" value="0.5"/>
        <DOF robot="madar" name="arm_right_wrist_3_joint" value="0.5"/>

		<!-- END: ARM RIGHT -->

		<!-- BEGIN: ARM LEFT -->

        <DOF robot="madar" name="arm_left_shoulder_pan_joint" value="0.5"/>
        <DOF robot="madar" name="arm_left_shoulder_lift_joint" value="0.5"/>
        <DOF robot="madar" name="arm_left_elbow_joint" value="0.5"/>
        <DOF robot="madar" name="arm_left_wrist_1_joint" value="0.5"/>
        <DOF robot="madar" name="arm_left_wrist_2_joint" value="0.5"/>
        <DOF robot="madar" name="arm_left_wrist_3_joint" value="0.5"/>

		<!-- END: ARM LEFT -->

	</Offset>


	<!-- ################################ -->
	<!-- #### CONTROLLERS : PLATFORM #### -->
	<!-- ################################ -->

	<!-- BEGIN: PLATFORM -->
	<Control name="madar_platform_x" eigValue="1.0">
		<DOF robot="madar" name="X" value="1.0" />
	</Control>

	<Control name="madar_platform_y" eigValue="1.0">
		<DOF robot="madar" name="Y" value="1.0" />
	</Control>

	<Control name="madar_platform_Rz" eigValue="1.0">
		<DOF robot="madar" name="X3" value="1.0" />
	</Control>
	<!-- END: PLATFORM -->

	<!-- BEGIN: ARM RIGHT -->
	<Control name="madar_arm_right_shoulder_pan_joint" eigValue="1.0">
		<DOF robot="madar" name="arm_right_shoulder_pan_joint" value="1.0" />
	</Control>

	<Control name="madar_arm_right_shoulder_lift_joint" eigValue="1.0">
		<DOF robot="madar" name="arm_right_shoulder_lift_joint" value="1.0" />
	</Control>

	<Control name="madar_arm_right_elbow_joint" eigValue="1.0">
		<DOF robot="madar" name="arm_right_elbow_joint" value="1.0" />
	</Control>

	<Control name="madar_arm_right_wrist_1_joint" eigValue="1.0">
		<DOF robot="madar" name="arm_right_wrist_1_joint" value="1.0" />
	</Control>

	<Control name="madar_arm_right_wrist_2_joint" eigValue="1.0">
		<DOF robot="madar" name="arm_right_wrist_2_joint" value="1.0" />
	</Control>

	<Control name="madar_arm_right_wrist_3_joint" eigValue="1.0">
		<DOF robot="madar" name="arm_right_wrist_3_joint" value="1.0" />
	</Control>
	<!-- END: ARM RIGHT -->

	<!-- BEGIN: ARM LEFT -->
	<Control name="madar_arm_left_shoulder_pan_joint" eigValue="1.0">
		<DOF robot="madar" name="arm_left_shoulder_pan_joint" value="1.0" />
	</Control>

	<Control name="madar_arm_left_shoulder_lift_joint" eigValue="1.0">
		<DOF robot="madar" name="arm_left_shoulder_lift_joint" value="1.0" />
	</Control>

	<Control name="madar_arm_left_elbow_joint" eigValue="1.0">
		<DOF robot="madar" name="arm_left_elbow_joint" value="1.0" />
	</Control>

	<Control name="madar_arm_left_wrist_1_joint" eigValue="1.0">
		<DOF robot="madar" name="arm_left_wrist_1_joint" value="1.0" />
	</Control>

	<Control name="madar_arm_left_wrist_2_joint" eigValue="1.0">
		<DOF robot="madar" name="arm_left_wrist_2_joint" value="1.0" />
	</Control>

	<Control name="madar_arm_left_wrist_3_joint" eigValue="1.0">
		<DOF robot="madar" name="arm_left_wrist_3_joint" value="1.0" />
	</Control>
	<!-- END: ARM LEFT -->

</ControlSet>